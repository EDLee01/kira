{
  "name": "kira",
  "version": "0.1.0",
  "private": true,
  "description": "Kira — AI desktop assistant",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --external:playwright --external:better-sqlite3 --tsconfig=tsconfig.json && esbuild src/preload/index.ts --bundle --platform=node --outfile=dist/preload/index.js --external:electron --tsconfig=tsconfig.json",
    "dev": "npm run dev:main && concurrently -k \"npm run dev:renderer\" \"sleep 2 && NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --outfile=dist/main/index.js --external:electron --external:playwright --external:better-sqlite3 --tsconfig=tsconfig.json && esbuild src/preload/index.ts --bundle --platform=node --outfile=dist/preload/index.js --external:electron --tsconfig=tsconfig.json",
    "build:core": "esbuild src/core/agent/query.ts --bundle --platform=node --outfile=dist/core/agent/query.js --external:electron --external:playwright --external:better-sqlite3 --tsconfig=tsconfig.json",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "start": "NODE_ENV=production electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "playwright": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.20.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
